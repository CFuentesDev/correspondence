<odoo>
    <data>
        <record id="correspondence_document_view_form" model="ir.ui.view" >
            <field name="name">correspondence_document.form</field>
            <field name="model">correspondence_document</field>
            <field name="arch" type="xml">
                <form string="Documento de Correspondencia">
                    <header>
                        <field name="is_current_user_recipient" invisible="1"/>
                        <field name="already_read_by_my_department" invisible="1"/>
                        <field name="director_has_digital_signature" invisible="1"/>
                        
                <!-- Firma Digital: visible si el director tiene firma y sello -->
                <button name="action_sign" string="Firmar y Sellar" type="object" class="oe_highlight" 
                        invisible="not id or state != 'draft' or correspondence_flow == 'incoming' or not director_has_digital_signature" 
                        groups="correspondence.correspondence_group_director"/>

                <!-- Descargar Documento: disponible siempre (con o sin firma del gerente y en cualquier estado) -->
                <button name="action_generate_report" string="Descargar Documento (PDF)" type="object" class="btn-secondary" 
                        invisible="not id or correspondence_flow == 'incoming'"/>

                <!-- Descargar en Formato Editable Word (.docx) -->
                <button name="action_download_docx" string="Descargar Editable (.docx)" type="object" class="btn-secondary" 
                        invisible="not id or correspondence_flow == 'incoming'"/>

                <!-- Subir Documento Firmado: disponible en borrador independientemente de si tiene firma digital -->
                <button name="%(correspondence.action_upload_signed_document_wizard)d" string="Subir Documento Firmado" type="action" class="btn-secondary" 
                        invisible="not id or state != 'draft' or correspondence_flow == 'incoming'" 
                        groups="correspondence.correspondence_group_director"/>

                <!-- Regenerar PDF: actualiza el PDF firmado adjunto con cambios recientes de plantilla o sellos -->
                <button name="action_regenerate_pdf" string="Regenerar PDF" type="object" class="btn-secondary"
                        invisible="not id or state == 'draft' or correspondence_flow == 'incoming'"/>

                <!-- Devolver a Borrador / Reutilizar Correlativo: restringido a Directores / Dirección Ejecutiva -->
                <button name="action_reset_to_draft" string="Devolver a Borrador" type="object" class="btn-warning"
                        invisible="not id or state == 'draft' or (correspondence_flow == 'incoming' and state == 'received')"
                        groups="correspondence.correspondence_group_director,correspondence.correspondence_group_admin"/>
                
                <button name="action_send" string="Enviar (Interno)" type="object" class="oe_highlight" 
                        invisible="state != 'signed' or correspondence_flow != 'internal'"/>

                <button name="action_dispatch" string="Despachar (Externo)" type="object" class="oe_highlight" 
                        invisible="state != 'signed' or correspondence_flow != 'outgoing'" 
                        groups="correspondence.correspondence_group_external_management"/>

                <button name="action_assign" string="Asignar a Departamentos" type="object" class="oe_highlight" 
                        invisible="state not in ['draft', 'received'] or correspondence_flow != 'incoming'"/>

                <!-- Cargar documento escaneado: solo para correspondencia entrante -->
                <button name="%(correspondence.action_upload_scanned_document_wizard)d" string="Cargar Documento Escaneado" type="action" class="btn-secondary" 
                        invisible="state not in ['draft', 'received'] or correspondence_flow != 'incoming'"
                        groups="correspondence.correspondence_group_external_management"/>
                
                <button name="action_read" string="Marcar como Leído" type="object" class="btn-secondary" 
                        invisible="state not in ['sent', 'assigned'] or not is_current_user_recipient or already_read_by_my_department"/>

                <button name="action_reply" string="Responder" type="object" class="oe_highlight" 
                        invisible="(correspondence_flow != 'incoming' and not is_current_user_recipient) or state not in ['sent', 'assigned', 'replied']"/>

                <field name="state" widget="statusbar" statusbar_visible="draft,received,assigned,signed,sent,dispatched,replied"/>
            </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Asunto del documento" readonly="state not in ['draft', 'received']"/></h1>
                        </div>
                        <group invisible="not parent_document_id">
                            <field name="parent_document_id" readonly="1"/>
                        </group>
                        <field name="correspondence_flow" invisible="1"/>
                        <group>
                            <group>
                                <field name="correlative" readonly="1"/>
                                <field name="external_correlative" 
                                       invisible="correspondence_flow != 'incoming'"/>
                                <field name="author_id" invisible="1"/>
                                <field name="send_department_id" 
                                       readonly="state not in ['draft', 'received']" 
                                       invisible="correspondence_flow == 'incoming' or send_department_static" 
                                       required="correspondence_flow in ['internal', 'outgoing']"/>
                                <field name="send_department_static" string="Departamento Remitente"
                                       invisible="not send_department_static"/>
                                <field name="external_partner_id" 
                                       invisible="correspondence_flow != 'incoming'" 
                                       required="correspondence_flow == 'incoming'" 
                                       readonly="state not in ['draft', 'received']" 
                                       string="Entidad Remitente Externa" context="{'default_is_company': True}"/>
                                <field name="external_partner_ids"
                                       widget="many2many_tags"
                                       invisible="correspondence_flow != 'outgoing'"
                                       required="correspondence_flow == 'outgoing' and not external_partner_id"
                                       readonly="state not in ['draft', 'received']"
                                       string="Destinatario(s) Externo(s)"/>
                                <field name="external_address" invisible="correspondence_flow == 'internal'"/>
                                <field name="recipient_treatment"
                                       invisible="correspondence_flow == 'incoming'"
                                       readonly="state not in ['draft', 'received']"/>
                                <field name="recipient_closing"
                                       invisible="correspondence_flow == 'incoming'"
                                       readonly="state not in ['draft', 'received']"/>
                                <field name="include_recipient_title"
                                       invisible="correspondence_flow == 'incoming'"
                                       readonly="state not in ['draft', 'received']"/>
                            </group>
                            <group>
                                <field name="date" readonly="state not in ['draft', 'received']"/>
                                <field name="correspondence_type" options="{'no_create': True, 'no_open': True}" 
                                       readonly="state not in ['draft', 'received']" force_save="1"/>
                                <field name="recipient_department_ids" string="Departamentos Destinatarios"
                                    widget="many2many_tags"
                                    options="{'no_create': True, 'no_open': True}"
                                    invisible="correspondence_flow == 'outgoing' or recipient_departments_static" 
                                    required="correspondence_flow in ['internal', 'incoming']" 
                                    readonly="state not in ['draft', 'received']" 
                                    domain="[('id', '!=', excluded_department_id)]"/>
                                <field name="recipient_departments_static" string="Departamentos Destinatarios"
                                       invisible="not recipient_departments_static"/>
                                <field name="excluded_department_id" invisible="1"/>
                                <field name="cc_department_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_open': True}"
                                       invisible="correspondence_flow == 'incoming'"
                                       readonly="state not in ['draft', 'received']"/>
                                <field name="cc_partner_ids"
                                       widget="many2many_tags"
                                       invisible="correspondence_flow == 'incoming'"
                                       readonly="state not in ['draft', 'received']"/>
                                <field name="shipping_method" 
                                       invisible="correspondence_flow != 'outgoing'" 
                                       required="correspondence_flow == 'outgoing'"/>
                                <field name="physical_location_id" options="{'no_create': True}"/>
                                <field name="tiene_anexos"
                                       invisible="correspondence_flow == 'incoming'"
                                       readonly="state not in ['draft', 'received']"/>
                                <field name="show_page_numbers"
                                       invisible="correspondence_flow == 'incoming'"
                                       readonly="state not in ['draft', 'received']"/>
                                <field name="manual_total_pages"
                                       invisible="correspondence_flow == 'incoming' or not show_page_numbers"
                                       readonly="state not in ['draft', 'received']"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción" name="description">
                                <group invisible="correspondence_flow == 'incoming'">
                                    <field name="use_institutional_greeting"
                                           groups="correspondence.correspondence_group_director,correspondence.correspondence_group_admin"
                                           readonly="state not in ['draft', 'received']"/>
                                </group>
                                <div class="alert alert-secondary mb-2 py-2" role="status"
                                     invisible="correspondence_flow == 'incoming' or not use_institutional_greeting or not institutional_greeting">
                                    <strong>Saludo Institucional Oficial (Incluido automáticamente):</strong>
                                    <field name="institutional_greeting" readonly="1" nolabel="1"/>
                                </div>
                                <field name="descripcion" readonly="state not in ['draft', 'received']" placeholder="Escriba aquí el cuerpo principal del documento (los párrafos se separarán automáticamente con formato Georama 11pt)..."/>
                                <div class="alert alert-secondary mt-2 py-2" role="status"
                                     invisible="correspondence_flow == 'incoming' or not use_institutional_greeting or not institutional_farewell">
                                    <strong>Despedida Institucional Oficial (Incluida automáticamente):</strong>
                                    <field name="institutional_farewell" readonly="1" nolabel="1"/>
                                </div>
                            </page>
                            <page string="Anexos (Post-Firma)" name="printed_annexes" invisible="not tiene_anexos">
                                <div class="alert alert-info mb-2 py-2" role="status">
                                    <strong>Anexos Impresos Posteriores a la Firma:</strong> Todo el contenido cargado en esta pestaña (tablas, matrices, informes, imágenes de Cédula/RIF) se imprimirá en hojas posteriores al bloque de firma, conservando el cintillo, el correlativo del oficio y la numeración continua de páginas.
                                </div>
                                <field name="anexos_html" readonly="state not in ['draft', 'received']" placeholder="Pegue o redacte aquí las tablas, informes o imágenes de anexos que van después de la firma..."/>
                            </page>
                            <page string="Observaciones" name="observations">
                                <field name="observaciones" readonly="state not in ['draft', 'received']"/>
                            </page>
                            <page string="Adjuntos" name="attachments">
                                <group>
                                    <field string="Documento Firmado" name="document_file" filename="file_name" readonly="1"/>
                                    <field name="file_name" invisible="1"/>
                                    <separator string="Archivos Adicionales"/>
                                    <field name="extra_attachment_ids" widget="many2many_binary" readonly="state not in ['draft', 'received']"/>
                                </group>
                            </page>
                            <page string="Respuestas" name="replies">
                                <field name="child_document_ids" force_save="1" readonly="1"/>
                            </page>
                            <page string="Estado de Lectura" name="read_status">
                                <field name="read_status_ids" readonly="1">
                                    <list>
                                        <field name="department_id"/>
                                        <field name="read_by_user_id"/>
                                        <field name="read_date"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="correspondence_document_view_kanban" model="ir.ui.view">
            <field name="name">correspondence.document.kanban</field>
            <field name="model">correspondence_document</field>
            <field name="arch" type="xml">
                <kanban default_group_by="correspondence_type" class="o_kanban_mobile" group_create="false" default_order="correlative desc">
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <span><field name="name"/></span>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="correlative"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="mb-2">
                                        <i class="fa fa-calendar-o" aria-label="Fecha" title="Fecha"/> <field name="date"/>
                                    </div>
                                    <div class="mb-2">
                                        <i class="fa fa-paper-plane-o" aria-label="Remitente" title="Remitente"/> <field name="send_department_id"/>
                                    </div>
                                    <div class="mb-2">
                                        <i class="fa fa-users" aria-label="Destinatarios" title="Destinatarios"/> <field name="recipient_department_ids"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="correspondence_type"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-attf-class="badge #{(record.state &amp;&amp; ['draft', 'signed'].includes(record.state.raw_value)) ? 'text-bg-secondary' : 'text-bg-success'}">
                                            <field name="user_facing_state"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="correspondence_document_view_tree" model="ir.ui.view">
            <field name="name">correspondence_document.list</field>
            <field name="model">correspondence_document</field>
            <field name="arch" type="xml">
                <list string="Correspondencia" decoration-info="correspondence_flow == 'internal'" decoration-success="correspondence_flow == 'incoming'" decoration-warning="correspondence_flow == 'outgoing'">
                    <field name="correlative"/>
                    <field name="correspondence_flow" column_invisible="True"/>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="send_department_id"/>
                    <field name="recipient_department_ids" widget="many2many_tags"/>
                    <field name="user_facing_state" string="Estado"/>
                </list>
            </field>
        </record>
    </data>
        <!-- Vista Búsqueda -->
        <record id="correspondence_document_view_search" model="ir.ui.view">
            <field name="name">correspondence_document.search</field>
            <field name="model">correspondence_document</field>
            <field name="arch" type="xml">
                <search>
                    <separator/>
                    <field name="name" string="Asunto"/>
                    <field name="recipient_department_ids" string="Departamento Destinatario"/>
                    <searchpanel>
                        <field name="state" icon="fa-tasks" select="multi" enable_counters="1"/>
                        <field name="correspondence_type" icon="fa-folder" select="multi" enable_counters="1"/>
                        <field name="send_department_id" icon="fa-building-o" select="multi" enable_counters="1"/>
                        <field name="recipient_department_ids" string="Departamento Destinatario" icon="fa-users" select="multi" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>
</odoo>